WHITESPACE = _{ " " | "\t" | "\r" | NEWLINE | "\0" }

request  = _{ SOI ~ request_line ~ headers ~ body? ~ EOI }
response = _{ SOI ~ status_line ~ headers ~ body? ~ EOI }

method           =  { "GET" | "POST" | "PUT" | "DELETE" | "PATCH" | "HEAD" | "OPTIONS" }
url              =  { (ASCII_ALPHANUMERIC | "/" | ":" | "." | "-" | "_" | "?" | "=" | "&" | "%" | "~" | "@")+ }
protocol_version =  { "HTTP/" ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
status_code      =  { ASCII_DIGIT{3} }
status           =  { ASCII_ALPHA_UPPER+ }
request_line     = ${ method ~ " " ~ url ~ " " ~ protocol_version }
status_line      = ${ protocol_version ~ " " ~ status_code ~ " " ~ status }

headers      =  { header* }
header       = ${ header_name ~ ": " ~ (header_value ~ NEWLINE)? }
header_name  =  { (ASCII_ALPHANUMERIC | "-")+ }
header_value =  { (ASCII_ALPHANUMERIC | "-" | ";" | " " | ":" | "," | "/" | "'" | "\"" | "." | "=" | "+" | "*" | "_" | "{" | "}")+ }

body                = _{ body_full | body_redacted }
body_full           = _{ chunked_body | content_length_body }
chunk_size          = _{ ASCII_HEX_DIGIT+ }
chunked_body        = _{ chunk_size ~ json ~ "0" }
content_length_body = _{ json }
// Redacted body: nulled-out bytes (\0) are WHITESPACE per the rule above, so
// braces, redacted values, and redacted commas all disappear. What's left is
// a sequence of visible `pair_redacted` items, optionally separated by
// surviving commas, optionally surrounded by surviving braces.
body_redacted       = _{ "{"? ~ pair_redacted ~ (","? ~ pair_redacted)* ~ "}"? }

json   = _{ object | array }
pair   =  { quoted_key ~ ":" ~ value }
object =  {
    "{" ~ "}"
  | "{" ~ pair ~ ("," ~ pair)* ~ "}"
}
array  =  {
    "[" ~ "]"
  | "[" ~ value ~ ("," ~ value)* ~ "]"
}

// `value?` is followed-by-`:`-aware so it doesn't greedily consume the next
// pair's key when our own value was redacted (e.g. `"a":\0\0\0"b":1` should
// match as two pairs `"a":<missing>` + `"b":1`, not as `"a":"b"` + `:1`).
pair_redacted = ${ quoted_key ~ ":" ~ (value ~ !(":"))? }

quoted_key = _{ "\"" ~ key ~ "\"" }
key        =  { (ASCII_ALPHANUMERIC | "_")+ }
value      = _{ object | array | quoted_string | number | boolean | null }
boolean    =  { "true" | "false" }
null       =  { "null" }

quoted_string = _{ "\"" ~ string ~ "\"" }
string        =  { (ASCII_ALPHANUMERIC | "@" | "." | "-" | "_" | " " | ":" | "/" | "," | ";" | "=" | "+" | "*" | "%" | "~" | "!" | "#" | "$" | "&" | "'" | "(" | ")" | "[" | "]" | "{" | "}" | "<" | ">" | "?" | "|" | "\\" | "^" | "`")* }

number = @{
    "-"? ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*) ~ ("." ~ ASCII_DIGIT*)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}
